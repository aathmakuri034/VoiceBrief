# Google Cloud / Gemini Agent Enterprise Configuration (If using Gemini Agent Enterprise)
PROJECT_ID=your-project-id
LOCATION=us-central1

# Google AI Studio Configuration (If not using Gemini Agent Enterprise)
GEMINI_API_KEY=your-api-key

# Model Configuration
MODEL=gemini-2.0-flash-exp
VOICE_NAME=aoede

# For Job Extraction
EXTRACTION_MODEL=gemini-2.5-flash 

# Authentication Method
# Set to TRUE to use Gemini Agent Enterprise, FALSE to use Google AI Studio API Key
GOOGLE_GENAI_USE_ENTERPRISE=FALSE

# If using Gemini Agent Enterprise, setup Google Cloud Credentials:
# Option 1: Service Account Key
#   export GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# Option 2: Application Default Credentials (for local development)
#   gcloud auth application-default login
# Azure Blob Storage Setup
AZURE_STORAGE_CONNECTION_STRING=TODO
AZURE_CONTAINER_NAME=TODO